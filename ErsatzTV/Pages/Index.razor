@page "/"
@page "/system/health"
@using ErsatzTV.Application.Health
@using ErsatzTV.Core.Health
@using System.Reflection
@using System.Text.RegularExpressions
@using ErsatzTV.Core.Interfaces.GitHub
@using ErsatzTV.Core.Interfaces.Updates
@using ErsatzTV.Core.Updates
@using Microsoft.Extensions.Caching.Memory
@implements IDisposable
@inject IGitHubApiClient GitHubApiClient
@inject IUpdateAgentClient UpdateAgentClient
@inject IMemoryCache MemoryCache
@inject IMediator Mediator
@inject SystemStartup SystemStartup;

<MudForm Style="max-height: 100%">
    <div class="d-flex flex-column" style="height: 100vh; overflow-x: auto">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8">
            @if (!SystemStartup.IsDatabaseReady)
            {
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h4">Database is initializing</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>Please wait, this may take a few minutes.</MudText>
                        <MudText>This page will automatically refresh when the database is ready.</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudProgressCircular Color="Color.Primary" Size="Size.Medium" Indeterminate="true"/>
                    </MudCardActions>
                </MudCard>
            }
            else if (!SystemStartup.IsSearchIndexReady)
            {
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h4">Search Index is initializing</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>Please wait, this may take a few minutes.</MudText>
                        <MudText>This page will automatically refresh when the search index is ready.</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudProgressCircular Color="Color.Primary" Size="Size.Medium" Indeterminate="true"/>
                    </MudCardActions>
                </MudCard>
            }
            else
            {
                <div class="d-flex flex-row align-center mb-2">
                    <MudText Typo="Typo.h5">Health Checks</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Size="Size.Small"
                                   Class="ml-2"
                                   title="Re-run health checks"
                                   OnClick="@RefreshHealthChecks"/>
                </div>
                <MudDivider Class="mb-6"/>
                <MudTable Hover="true"
                          Dense="true"
                          Breakpoint="Breakpoint.None"
                          ServerData="@(ServerReload)"
                          @ref="_healthCheckTable">
                    <HeaderContent>
                        <MudTh>Check</MudTh>
                        <MudTh>Message</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div style="align-items: center; display: flex; flex-direction: row;">
                                @if (context.Status == HealthCheckStatus.Fail)
                                {
                                    <MudIcon Color="@Color.Error" Icon="@Icons.Material.Filled.Error"/>
                                }
                                else if (context.Status == HealthCheckStatus.Warning)
                                {
                                    <MudIcon Color="@Color.Warning" Icon="@Icons.Material.Filled.Warning"/>
                                }
                                else if (context.Status == HealthCheckStatus.Info)
                                {
                                    <MudIcon Color="@Color.Info" Icon="@Icons.Material.Filled.Info"/>
                                }
                                else
                                {
                                    <MudIcon Color="@Color.Success" Icon="@Icons.Material.Filled.Check"/>
                                }
                                <div class="ml-2">@context.Title</div>
                            </div>
                        </MudTd>
                        <MudTd>
                            <MudHidden Breakpoint="Breakpoint.Xs">
                                @if (context.Link.IsSome)
                                {
                                    foreach (HealthCheckLink link in context.Link)
                                    {
                                        if (link.Link.StartsWith("http"))
                                        {
                                            <MudLink Href="@link.Link" Target="_blank">
                                                @context.Message
                                            </MudLink>
                                        }
                                        else
                                        {
                                            <MudLink Href="@link.Link">
                                                @context.Message
                                            </MudLink>
                                        }
                                    }
                                }
                                else
                                {
                                    <MudText>
                                        @context.Message
                                    </MudText>
                                }
                            </MudHidden>
                            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                                @if (context.Link.IsSome)
                                {
                                    foreach (HealthCheckLink link in context.Link)
                                    {
                                        <MudLink Href="@link.Link">
                                            @context.BriefMessage
                                        </MudLink>
                                    }
                                }
                                else
                                {
                                    <MudText>
                                        @context.BriefMessage
                                    </MudText>
                                }
                            </MudHidden>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudPaper Class="mt-6 pa-4" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-2">Updates</MudText>
                    @if (!UpdateAgentClient.IsConfigured)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Update agent is not configured. On the host, set
                            <code>UPDATE_AGENT_TOKEN</code> in <code>/opt/ersatztv/local/env</code>,
                            enable <code>ersatztv-update-agent</code>, and redeploy compose so
                            <code>ETV_UPDATE_AGENT_URL</code> reaches the container.
                        </MudText>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-center gap-3 mb-3">
                            <MudSelect T="string"
                                       Label="Repository"
                                       Dense="true"
                                       Style="min-width: 18rem"
                                       Value="_selectedSourceId"
                                       ValueChanged="OnSourceChanged"
                                       Disabled="@(_sources.Count == 0 || _updating)">
                                @foreach (UpdateSource source in _sources)
                                {
                                    <MudSelectItem Value="@source.Id">@source.Label (@source.Branch)</MudSelectItem>
                                }
                            </MudSelect>
                            <MudChip T="string"
                                     Color="@UpdateChipColor()"
                                     Variant="Variant.Filled"
                                     Size="Size.Small">
                                @_updateStatusText
                            </MudChip>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@(!CanUpdate())"
                                       OnClick="StartUpdate">
                                @(_updating ? "Updating…" : "Update")
                            </MudButton>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_installedVersion))
                        {
                            <MudText Typo="Typo.caption" Class="mb-2">
                                Installed: @_installedVersion
                                @if (!string.IsNullOrWhiteSpace(_localSha))
                                {
                                    <span> · local @_localSha[..Math.Min(8, _localSha.Length)]</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(_remoteSha))
                                {
                                    <span> · remote @_remoteSha[..Math.Min(8, _remoteSha.Length)]</span>
                                }
                            </MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(_updateError))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_updateError</MudAlert>
                        }
                        <MudText Typo="Typo.caption" Class="mb-1">Update log</MudText>
                        <MudPaper Class="pa-2" Style="background: var(--mud-palette-background-grey); max-height: 12rem; overflow: auto; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.75rem; white-space: pre-wrap;">
                            @(_updateLog.Length == 0 ? "(no log yet)" : _updateLog)
                        </MudPaper>
                    }
                </MudPaper>

                <MudCard Class="mt-6">
                    <MudCardHeader>
                        <MudText Class="mt-6">Full changelog is available on <MudLink Href="https://github.com/ErsatzTV/legacy/blob/main/CHANGELOG.md" Target="_blank">GitHub</MudLink></MudText>
                    </MudCardHeader>
                    <MudCardContent Class="release-notes mud-typography mud-typography-body1">
                        <MarkdownView Content="@_releaseNotes"/>
                    </MudCardContent>
                </MudCard>
            }
        </MudContainer>
    </div>
</MudForm>

@code {
    private CancellationTokenSource _cts;

    private MudTable<HealthCheckResult> _healthCheckTable;

    private bool _refreshHealthChecks;

    private string _releaseNotes;

    private readonly List<UpdateSource> _sources = [];
    private string _selectedSourceId;
    private string _updateStatusText = "Checking…";
    private string _updateError;
    private string _updateLog = string.Empty;
    private string _installedVersion;
    private string _localSha;
    private string _remoteSha;
    private bool _updateAvailable;
    private bool _updating;
    private bool _updatePollStarted;
    private CancellationTokenSource _updateCts;

    protected override void OnInitialized()
    {
        SystemStartup.OnDatabaseReady += OnStartupProgress;
        SystemStartup.OnSearchIndexReady += OnStartupProgress;
    }

    public void Dispose()
    {
        SystemStartup.OnDatabaseReady -= OnStartupProgress;
        SystemStartup.OnSearchIndexReady -= OnStartupProgress;

        _cts?.Cancel();
        _cts?.Dispose();
        _updateCts?.Cancel();
        _updateCts?.Dispose();
    }

    private async void OnStartupProgress(object sender, EventArgs e)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // do nothing
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _updatePollStarted || !SystemStartup.IsDatabaseReady || !SystemStartup.IsSearchIndexReady)
        {
            return;
        }

        _updatePollStarted = true;
        if (!UpdateAgentClient.IsConfigured)
        {
            return;
        }

        _updateCts = new CancellationTokenSource();
        _ = PollUpdates(_updateCts.Token);
    }

    protected override async Task OnParametersSetAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            if (MemoryCache.TryGetValue("Index.ReleaseNotesHtml", out string releaseNotesHtml))
            {
                _releaseNotes = releaseNotesHtml;
            }
            else
            {
                var assembly = Assembly.GetEntryAssembly();
                if (assembly != null)
                {
                    string version = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;
                    if (version != null)
                    {
                        Either<BaseError, string> maybeNotes;

                        // develop builds report v<next release>-<sha8>-<target>; their release is
                        // v<next release>-<sha8>-develop in the develop builds repository
                        Match developBuild = Regex.Match(version, @"^v?(\d+\.\d+\.\d+)-([0-9a-f]{8})-");
                        if (developBuild.Success)
                        {
                            string developTag = $"v{developBuild.Groups[1].Value}-{developBuild.Groups[2].Value}-develop";
                            maybeNotes = await GitHubApiClient.GetDevelopReleaseNotes(developTag, token);
                            foreach (string notes in maybeNotes.RightToSeq())
                            {
                                _releaseNotes = notes;
                            }
                        }
                        else if (version != "develop")
                        {
                            string gitHubVersion = version.Split("-").Head();
                            if (!gitHubVersion.StartsWith("v"))
                            {
                                gitHubVersion = $"v{gitHubVersion}";
                            }

                            maybeNotes = await GitHubApiClient.GetReleaseNotes(gitHubVersion, token);
                            foreach (string notes in maybeNotes.RightToSeq())
                            {
                                _releaseNotes = notes;
                            }
                        }
                        else
                        {
                            maybeNotes = await GitHubApiClient.GetLatestReleaseNotes(token);
                            foreach (string notes in maybeNotes.RightToSeq())
                            {
                                _releaseNotes = notes;
                            }
                        }
                    }
                }

                if (_releaseNotes != null)
                {
                    MemoryCache.Set("Index.ReleaseNotesHtml", _releaseNotes);
                }
            }
        }
        catch (Exception)
        {
            // ignore
        }
    }

    private async Task PollUpdates(CancellationToken cancellationToken)
    {
        try
        {
            await LoadSources(cancellationToken);
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            do
            {
                await RefreshUpdateState(cancellationToken);
                await InvokeAsync(StateHasChanged);
            } while (await timer.WaitForNextTickAsync(cancellationToken));
        }
        catch (OperationCanceledException)
        {
            // page disposed
        }
        catch (Exception ex)
        {
            _updateError = ex.Message;
            _updateStatusText = "Agent error";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadSources(CancellationToken cancellationToken)
    {
        Either<BaseError, UpdateSourcesResponse> result = await UpdateAgentClient.GetSources(cancellationToken);
        foreach (BaseError error in result.LeftToSeq())
        {
            _updateError = error.Value;
            _updateStatusText = "Agent unavailable";
        }

        foreach (UpdateSourcesResponse response in result.RightToSeq())
        {
            _sources.Clear();
            _sources.AddRange(response.Sources ?? []);
            if (string.IsNullOrWhiteSpace(_selectedSourceId) && _sources.Count > 0)
            {
                _selectedSourceId = _sources[0].Id;
            }
        }
    }

    private async Task RefreshUpdateState(CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(_selectedSourceId))
        {
            return;
        }

        Either<BaseError, UpdateStatusResponse> statusResult = await UpdateAgentClient.GetStatus(cancellationToken);
        foreach (UpdateStatusResponse status in statusResult.RightToSeq())
        {
            _updating = status.Updating;
            _installedVersion = status.InstalledVersion;
            if (!string.IsNullOrWhiteSpace(status.LastError) && status.LastOk == false)
            {
                _updateError = status.LastError;
            }
        }

        Either<BaseError, UpdateCheckResponse> checkResult =
            await UpdateAgentClient.Check(_selectedSourceId, cancellationToken);
        foreach (BaseError error in checkResult.LeftToSeq())
        {
            _updateError = error.Value;
            _updateStatusText = _updating ? "Updating…" : "Check failed";
        }

        foreach (UpdateCheckResponse check in checkResult.RightToSeq())
        {
            _updateError = null;
            _updateAvailable = check.UpdateAvailable;
            _localSha = check.LocalSha;
            _remoteSha = check.RemoteSha;
            _installedVersion = check.InstalledVersion ?? _installedVersion;
            _updateStatusText = _updating
                ? "Updating…"
                : _updateAvailable
                    ? "Update available"
                    : "Up to date";
        }

        Either<BaseError, string> logResult = await UpdateAgentClient.GetLog(cancellationToken);
        foreach (string log in logResult.RightToSeq())
        {
            _updateLog = log ?? string.Empty;
        }
    }

    private async Task OnSourceChanged(string sourceId)
    {
        _selectedSourceId = sourceId;
        if (_updateCts is { IsCancellationRequested: false })
        {
            await RefreshUpdateState(_updateCts.Token);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartUpdate()
    {
        if (!CanUpdate())
        {
            return;
        }

        _updating = true;
        _updateStatusText = "Updating…";
        _updateError = null;
        Either<BaseError, UpdateStartResponse> result =
            await UpdateAgentClient.StartUpdate(_selectedSourceId, CancellationToken.None);
        foreach (BaseError error in result.LeftToSeq())
        {
            _updating = false;
            _updateError = error.Value;
            _updateStatusText = "Update failed to start";
        }

        Either<BaseError, string> logResult = await UpdateAgentClient.GetLog(CancellationToken.None);
        foreach (string log in logResult.RightToSeq())
        {
            _updateLog = log ?? string.Empty;
        }
    }

    private bool CanUpdate() =>
        UpdateAgentClient.IsConfigured
        && !_updating
        && _updateAvailable
        && !string.IsNullOrWhiteSpace(_selectedSourceId);

    private Color UpdateChipColor()
    {
        if (_updating)
        {
            return Color.Info;
        }

        if (!string.IsNullOrWhiteSpace(_updateError))
        {
            return Color.Error;
        }

        return _updateAvailable ? Color.Warning : Color.Success;
    }

    private async Task RefreshHealthChecks()
    {
        _refreshHealthChecks = true;

        if (_healthCheckTable != null)
        {
            await _healthCheckTable.ReloadServerData();
        }
    }

    private async Task<TableData<HealthCheckResult>> ServerReload(TableState state, CancellationToken cancellationToken)
    {
        bool refresh = _refreshHealthChecks;
        _refreshHealthChecks = false;

        List<HealthCheckResult> healthCheckResults = await Mediator.Send(new GetAllHealthCheckResults(refresh), cancellationToken);

        return new TableData<HealthCheckResult>
        {
            TotalItems = healthCheckResults.Count,
            Items = healthCheckResults
        };
    }

}
